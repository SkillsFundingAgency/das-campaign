@using System.Text
@using Microsoft.AspNetCore.Mvc.ModelBinding
@model SFA.DAS.Campaign.Web.Models.RegisterInterestModel

@{
    ViewBag.Title = "Get tailored advice on hiring an apprentice";
    ViewBag.PageTitle = "Get tailored advice on hiring an apprentice";
    ViewBag.PageSummary = "Fill in your details and we’ll send you advice matched to your company size, industry and region.";
    Layout = "Layout_EmployersHub";

    ViewBag.LandingPageSlug = "register-interest";
    ViewBag.LandingPageTitle = "Get tailored advice on hiring an apprentice";

    var errorOrder = new List<string>()
    {
        "SizeOfYourCompany",
        "Industry",
        "Location",
        "FirstName",
        "LastName",
        "Email",
        "Route",
        "AcceptTandCs"
    };

    Func<string, bool> isInvalid = field => ViewData.ModelState[field]?.ValidationState == ModelValidationState.Invalid;
}

<div class="fiu-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-error-summary" data-module="govuk-error-summary" style="@(ViewData.ModelState.IsValid ? " display: none" : "")">
                <h2 class="govuk-error-summary__title">There's a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul role="list" class="govuk-list govuk-error-summary__list">
                        @{
                            var errorStringBuilder = new StringBuilder();
                            foreach (var error in errorOrder)
                            {
                                if (ViewData.ModelState[error]?.ValidationState == ModelValidationState.Invalid)
                                {
                                    var errorKey = error == "Route" ? "rbApprentice" : error;
                                    errorStringBuilder.Append($" <li role=\"listitem\"><a href =\"#{errorKey}\" class=\"govuk-form-validation-summary__link\">{Model.ValidationMessages[error]}</a></li>");
                                }
                            }
                        }
                        @Html.Raw(errorStringBuilder.ToString())
                    </ul>
                </div>
            </div>


            <form asp-controller="RegisterInterest" asp-action="index">
                
                <div class="fiu-article">
                <h2 class="govuk-heading-l">About your company</h2>
                <fieldset class="govuk-fieldset" aria-describedby="@(isInvalid("SizeOfYourCompany") ? "ukHint SizeOfYourCompany-error" : "ukHint")">
                    <legend class="govuk-fieldset__legend govuk-!-font-weight-bold">Your company size</legend>
                    <div class="govuk-form-group" highlight-error-for="SizeOfYourCompany">
                        <div class="govuk-hint" id="ukHint">Only include people based in the UK</div>
                        <span id="SizeOfYourCompany-error" asp-validation-for="@Model.SizeOfYourCompany" class="govuk-error-message"></span>

                        <div class="govuk-radios" data-module="govuk-radios" das-validation-for="SizeOfYourCompany" das-validationerror-class="form-group-validation-error">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="SizeOfYourCompany" name="SizeOfYourCompany" type="radio" value="Less than 10 employees" asp-for="@Model.SizeOfYourCompany">
                                <label class="govuk-label govuk-radios__label" for="SizeOfYourCompany">
                                    Less than 10 employees
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="between10and49employees" name="SizeOfYourCompany" type="radio" value="Between 10 and 49 employees" asp-for="@Model.SizeOfYourCompany">
                                <label class="govuk-label govuk-radios__label" for="between10and49employees">
                                    Between 10 and 49 employees
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="between50and249employees" name="SizeOfYourCompany" type="radio" value="Between 50 and 249 employees" asp-for="@Model.SizeOfYourCompany">
                                <label class="govuk-label govuk-radios__label" for="between50and249employees">
                                    Between 50 and 249 employees
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="over250employees" name="SizeOfYourCompany" type="radio" value="Over 250 employees" asp-for="@Model.SizeOfYourCompany">
                                <label class="govuk-label govuk-radios__label" for="over250employees">
                                    Over 250 employees
                                </label>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <div class="govuk-form-group" highlight-error-for="Industry">
                    <label for="Industry" class="govuk-label govuk-!-font-weight-bold">Your industry</label>
                    <span id="Industry-error" asp-validation-for="@Model.Industry" class="govuk-error-message"></span>
                    <select class="govuk-select govuk-!-width-full" asp-for="Industry" data-val="true" das-validation-for="Industry" das-validationerror-class="form-group-validation-error" id="Industry" name="Industry" aria-describedby="@(isInvalid("Industry") ? "Industry-error" : null)">
                        <option>Agriculture, environmental and animal care</option>
                        <option>Business and administration</option>
                        <option>Care services</option>
                        <option>Catering and hospitality</option>
                        <option>Construction and the built environment</option>
                        <option>Creative and design</option>
                        <option>Digital</option>
                        <option>Education and early years</option>
                        <option>Engineering and manufacturing</option>
                        <option>Hair and beauty</option>
                        <option>Health and science</option>
                        <option>Legal, finance and accounting</option>
                        <option>Protective services</option>
                        <option>Sales, marketing and procurement</option>
                        <option>Transport and logistics</option>
                        <option value="" selected="selected">Choose your industry</option>
                    </select>
                </div>

                <div class="govuk-form-group" highlight-error-for="Location">
                    <label for="Location" class="govuk-label govuk-!-font-weight-bold">Your region</label>
                    <span id="Location-error" asp-validation-for="@Model.Location" class="govuk-error-message"></span>
                    <select class="govuk-select govuk-!-width-full" asp-for="Location" data-val="true" das-validation-for="Location" das-validationerror-class="form-group-validation-error" id="Location" name="Location" aria-describedby="@(isInvalid("Location") ? "Location-error" : null)">
                        <option>South West</option>
                        <option>South East</option>
                        <option>London</option>
                        <option>East of England</option>
                        <option>East Midlands</option>
                        <option>West Midlands</option>
                        <option>North West</option>
                        <option>Yorkshire and Humber</option>
                        <option>North East</option>
                        <option value="" selected="selected">Choose your location</option>
                    </select>
                </div>

                <input asp-for="Route" value="Employer" type="hidden"/>
  


                </div>
                <div class="fiu-article">
                        <h2 class="govuk-heading-l">Your details</h2>
                        
                        <div class="govuk-hint">
                            Your data is protected under the terms of our <a href="/policies/privacy" class="govuk-link">privacy policy</a>. You can unsubscribe from these emails at any time.
                        </div>
                        
                        <input type="hidden" asp-for="Version"/>
                        <div class="govuk-form-group" highlight-error-for="FirstName" das-validation-for="FirstName" das-validationerror-class="form-group-validation-error">

                            <label class="govuk-label govuk-!-font-weight-bold" asp-for="FirstName">
                                First name
                            </label>
                            <span id="FirstName-error" asp-validation-for="@Model.FirstName" class="govuk-error-message"></span>
                            <input id="FirstName" class="govuk-input" asp-for="FirstName" type="text" autocomplete="given-name" aria-describedby="@(isInvalid("FirstName") ? "FirstName-error" : null)">
                        </div>

                        <div class="govuk-form-group" highlight-error-for="LastName" das-validation-for="LastName" das-validationerror-class="form-group-validation-error">

                            <label class="govuk-label govuk-!-font-weight-bold" asp-for="LastName">
                                Last name
                            </label>
                            <span id="LastName-error" asp-validation-for="@Model.LastName" class="govuk-error-message"></span>
                            <input id="LastName" class="govuk-input" asp-for="LastName" type="text" autocomplete="family-name" aria-describedby="@(isInvalid("LastName") ? "LastName-error" : null)">
                        </div>

                        <div class="govuk-form-group" highlight-error-for="Email" das-validation-for="Email" das-validationerror-class="form-group-validation-error">
                            <label class="govuk-label govuk-!-font-weight-bold" asp-for="Email">
                                Email address
                            </label>
                            <span id="Email-error" asp-validation-for="@Model.Email" class="govuk-error-message"></span>
                            <div class="govuk-hint">We’ll only use this to send you your tailored advice</div>
                            <input id="Email" class="govuk-input" asp-for="Email" type="text" autocomplete="email" aria-describedby="@(isInvalid("Email") ? "Email-error" : null)">
                        </div>
                        
                        <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Take part in research</h3>
                        <div class="govuk-hint">You could help shape the apprenticeship service by taking part in research. </div>
                        <div class="govuk-form-group" das-validation-for="IncludeInUR" das-validationerror-class="form-group-validation-error">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input fiu-checkboxes__input" asp-for="IncludeInUR" type="checkbox" value="true">
                                <label class="govuk-label govuk-checkboxes__label fiu-checkboxes__label" asp-for="IncludeInUR">
                                    I am happy to take part in research that'll help improve the Apprenticeship Service.
                                </label>
                            </div>
                        </div>
                        <input asp-for="ReturnUrl" type="hidden" value="@Model.ReturnUrl"/>
                    <button formnovalidate="formnovalidate" class="fiu-button fiu-button--employers govuk-!-margin-bottom-0" name="registerInterestSubmit" type="submit" id="btn-register-interest-complete">Sign up</button>

                </div>

            </form>
        </div>
    </div>
</div>


