@using System.Linq
@using SFA.DAS.Campaign.Web.Helpers
@using SFA.DAS.Campaign.Web.Renderers
@model SFA.DAS.Campaign.Web.Models.AnnouncementPageViewModel
@{
    var announcement = Model.Content;
    ViewBag.Title = Model.Title;
    ViewBag.MetaDesc = Model.MetaContent?.MetaDescription;
    Layout = "Layout_EmployersHub";
    ViewBag.PageTitle = Model.Title;
    ViewBag.PageSummary = announcement.PublishedDate.ToGovUkDateString();
    ViewBag.ParentPageUrl = Model.ListPageUrl;
    ViewBag.ParentPageTitle = Model.ListPageTitle;
}

<div class="fiu-width-container">
    <div class="govuk-grid-row app-page-start">
        <div class="govuk-grid-column-one-third">
            @if (announcement.Sections != null && announcement.Sections.Any())
            {
                <h2 class="govuk-heading-m app-anchor-links__heading">On this page</h2>
                <ul role="list" class="govuk-list govuk-list--spaced app-anchor-links app-anchor-links__list app-anchor-links__list--dash govuk-!-margin-bottom-9">
                    @foreach (var tab in announcement.Sections)
                    {
                        <li role="listitem" class="app-anchor-links__list-item">
                            <a class="govuk-link govuk-link--no-visited-state app-anchor-links__link" href="#@tab.TabTitle.EnsureHrefUsableTitle()">@tab.TabTitle</a>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="govuk-grid-column-two-thirds">
            <article class="fiu-article">@announcement.Content.ToHtml()</article>
            @if (announcement.Sections != null && announcement.Sections.Any())
            {
                foreach (var tab in announcement.Sections)
                {
                    <div class="app-anchor-links__panel" id="@tab.TabTitle.EnsureHrefUsableTitle()">
                        <article class="fiu-article">
                            @tab.Content.ToHtml()
                        </article>
                        <a href="#main" class="fiu-back-link--top">Back to top</a>
                    </div>
                }
            }
            @if (announcement.UpdatedDate.HasValue)
            {
                <p class="govuk-body govuk-hint">
                    <strong>Last updated: </strong>
                    <time datetime="@announcement.UpdatedDate.ToIsoDateString()">@announcement.UpdatedDate.ToGovUkDateString()</time>
                </p>
            }
        </div>
    </div>
    <hr class="govuk-section-break govuk-section-break--xl" />
</div>
