@model SFA.DAS.Campaign.Domain.Content.CtaPanel
@{
    if (Model == null)
    {
        return;
    }
    var hasButton = !string.IsNullOrWhiteSpace(Model.ButtonText);
}
<a class="fiu-panel fiu-panel--left-align fiu-cta-panel" href="@Model.Url">
    @if (!string.IsNullOrWhiteSpace(Model.Icon))
    {
        <partial name="Hubs/_HubCtaIcon" model="@Model.Icon" />
    }
    <div class="fiu-cta-panel__body">
        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 class="govuk-heading-m govuk-!-margin--top-0 govuk-!-margin-bottom-2">@Model.Heading</h2>
        } 
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>
    @if (hasButton)
    {
        <div class="fiu-cta-panel__action">
            <span class="fiu-cta-panel__button">
                @(string.IsNullOrWhiteSpace(Model.ButtonText) ? Model.Heading : Model.ButtonText)
            </span>
        </div>
    }
</a>
